{
  "name": "ilu",
  "version": "1.0.4",
  "type": "module",
  "description": "Cli tools for productivity, notes, todo-lists, etc...",
  "author": "Masquerade <christian@masquerade-circus.net>",
  "repository": "git@github.com:Masquerade-Circus/ilu.git",
  "license": "Apache-2.0",
  "files": [
    "bin/",
    "clocks/",
    "notes/",
    "scrumban/",
    "sync/",
    "sync-core/",
    "todos/",
    "translate/",
    "tts/",
    "types.d.ts",
    "ui/",
