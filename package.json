{
  "name": "ilu",
  "version": "2.0.0",
  "type": "module",
  "description": "Cli tools for productivity, notes, todo-lists, etc...",
  "author": "Masquerade <christian@masquerade-circus.net>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Masquerade-Circus/ilu.git"
  },
  "license": "Apache-2.0",
  "files": [
    "bin/",
    "clocks/",
    "notes/",
    "scrumban/",
    "sync/",
    "todos/",
    "translate/",
    "tts/",
    "types.d.ts",
    "ui/",
    "utils/",
    "cli.ts",
    "tsconfig.json",
    "!**/*.test.ts",
    "!**/tests/"
  ],
  "bin": {
    "ilu": "bin/cli.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --import tsx --import ./support/test-home-guard.ts --test tests/*.test.ts tests/test-helpers/*.test.ts translate/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:diagram": "node --import tsx ./sync/generate-diagrams.ts",
    "release": "release-it"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@valyrianjs/terminal": "^0.2.12",
    "cli-table": "^0.3.11",
    "clipboardy": "^5.3.1",
    "colors": "^1.3.2",
    "commander": "^14.0.3",
    "iludb": "2.0.0",
    "lodash": "^4.17.11",
    "openai": "^6.34.0",
    "sync-core": "1.0.0",
    "tsx": "^4.22.4",
    "valyrian.js": "^9.1.13",
    "x-robot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "release-it": "^19.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Masquerade-Circus/ilu/issues"
  },
  "homepage": "https://github.com/Masquerade-Circus/ilu#readme",
  "release-it": {
    "plugins": {},
    "git": {
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "hooks": {
      "before:init": [],
      "after:bump": [],
      "after:@release-it/conventional-changelog": []
    }
  }
}
