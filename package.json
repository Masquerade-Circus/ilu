    "commander": "^14.0.3",
    "iludb": "^1.0.0",
    "lodash": "^4.17.11",
    "openai": "^6.34.0",
    "tsx": "^4.22.4",
    "valyrian.js": "^9.1.13",
    "x-robot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
